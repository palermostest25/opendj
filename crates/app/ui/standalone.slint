// The Standalone layout, for playing from a controller as from a standalone
// unit (the XDJ-AZ's screen): the decks' scrolling waveforms stacked large
// across the top, and a row of deck panels along the bottom, each with its
// track, an overview to tap or drag through, the BPM, tempo, key and time
// in large type, and buttons for MASTER TEMPO, SYNC, MASTER, QUANTIZE, SLIP
// and beat jumps. The browser opens in a window of its own (browse.slint).
import { Theme } from "theme.slint";
import { Controls, ControlButton } from "controls.slint";
import { DeckInfo, Cover, BeatBox, BeatCounter } from "deck.slint";
import { TrackDrag } from "library.slint";

// How many decks Standalone shows, from the top bar's DECKS button:
// 0 Automatic (four while deck 3 or 4 has a track or a controller plays
// them), 2 or 4. Kept in settings.json as `standalone_decks`.
export global StandaloneUi {
    in-out property <int> decks: 0;
    callback decks-changed(decks: int);
    // The Browse window is open, from the top bar's BROWSE button.
    in-out property <bool> browse-open;
    callback browse-toggled(open: bool);
}

// A large reading with a small label over it: TIME, BPM, KEY.
component Readout inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <color> value-color: Theme.text;
    in property <length> size: 26px;
    in property <TextHorizontalAlignment> align: left;
    alignment: center;
    spacing: 0px;
    Text { text: label; color: Theme.text-dim; font-size: 9px; font-weight: 700; letter-spacing: 0.8px; horizontal-alignment: align; }
    HorizontalLayout {
        alignment: align == TextHorizontalAlignment.right ? end : start;
        spacing: 6px;
        Text { text: value; color: value-color; font-family: "Inter Tabular"; font-size: size; font-weight: 600; vertical-alignment: bottom; overflow: elide; }
        if detail != "": Text { text: detail; color: Theme.text-dim; font-family: "Inter Tabular"; font-size: size * 0.5; vertical-alignment: bottom; }
    }
}

// A stem of the deck's track: lit in its colour while it plays, dark and
// struck through while muted. Tapping it mutes or unmutes it, as the
// FLX10's ACTIVE PART does.
component StemChip inherits Rectangle {
    in property <string> name;
    in property <color> tint;
    in property <string> group;
    property <int> mute-index: Controls.resolve(group, "mute");
    property <bool> muted: Controls.value(mute-index, Controls.tick) > 0;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: muted ? Theme.control : tint.with-alpha(ta.pressed ? 0.5 : 0.3);
    border-width: 1px;
    border-color: muted ? Theme.border : tint;
    Text {
        text: name;
        color: muted ? Theme.text-dim : Theme.text;
        font-size: 11px;
        font-weight: 700;
        overflow: elide;
    }
    if muted: Rectangle { width: parent.width - 16px; height: 1px; background: Theme.text-dim; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { Controls.toggle(mute-index); } }
}

// One deck's panel along the bottom.
export component StandaloneDeck inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    out property <length> overview-width: ov.width;
    out property <length> overview-height: ov.height;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    property <bool> playing: Controls.value(Controls.resolve(group, "play"), Controls.tick) > 0;
    property <bool> looping: Controls.value(Controls.resolve(group, "loop_enabled"), Controls.tick) > 0;
    // Room for the cover, the long MASTER TEMPO and SLIP (StandaloneView
    // works it out from the window, as reading its own width would loop).
    in property <bool> wide: true;
    property <int> position-index: Controls.resolve(group, "playposition");
    property <int> hold-index: Controls.resolve(group, "seek_hold");
    property <float> jump: Controls.value(Controls.resolve(group, "beatjump_size"), Controls.tick);
    property <string> jump-label: jump >= 1 ? round(jump) : jump == 0.5 ? "1/2" : jump == 0.25 ? "1/4" : "1/8";
    // Where a press on the overview started, and whether it became a drag.
    property <length> press-x;
    property <bool> scrubbing;
    background: Theme.panel;

    // Tracks dragged from the browser load here, as on the other layouts.
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) ? DragAction.copy : DragAction.none }
        dropped(e) => {
            TrackDrag.drop(deck, e.data);
            TrackDrag.active = false;
            DragAction.copy
        }
    }
    // The deck's colour along the top, bright while it plays.
    Rectangle { y: 0; height: 3px; background: playing ? tint : tint.with-alpha(0.35); }

    VerticalLayout {
        padding: 8px;
        padding-top: 10px;
        spacing: 6px;
        // The deck number, the cover, the title and artist, the beat counter.
        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            Rectangle {
                width: 34px;
                border-radius: 5px;
                background: playing ? tint : Theme.control;
                border-width: 2px;
                border-color: tint;
                Text { text: deck + 1; color: playing ? #000000 : Theme.text; font-size: 20px; font-weight: 800; }
            }
            if wide: Cover { deck: deck; tint: tint; info: info; size: 40px; }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text { text: info.loaded ? info.title : "Empty deck"; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                Text { text: info.loaded ? info.artist : "Load a track from the Browse window"; color: Theme.text-dim; font-size: 12px; overflow: elide; }
            }
            if info.loaded && BeatCounter.decks[deck].shown: BeatBox { count: BeatCounter.decks[deck]; tint: tint; compact: true; }
        }
        // The overview: tap to skip there, drag to move through the track.
        ov := Rectangle {
            height: 46px;
            background: Theme.well;
            // Not rounded: a rounded clip renders into a cached layer, which
            // would freeze the GPU-updated image.
            clip: true;
            Image { width: parent.width; height: parent.height; source: overview; image-fit: fill; }
            if info.automix-to > info.automix-from: Rectangle {
                x: info.automix-from * parent.width;
                width: (info.automix-to - info.automix-from) * parent.width;
                background: Theme.automix.with-alpha(0.18);
            }
            ota := TouchArea {
                mouse-cursor: ew-resize;
                pointer-event(e) => {
                    if e.button != PointerEventButton.left && e.kind != PointerEventKind.cancel {
                        return;
                    }
                    if e.kind == PointerEventKind.down {
                        press-x = self.mouse-x;
                        scrubbing = false;
                        Controls.set-value(position-index, clamp(self.mouse-x / self.width, 0, 1));
                    } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                        if scrubbing {
                            Controls.set-value(hold-index, 0);
                        }
                        scrubbing = false;
                    }
                }
                moved => {
                    if self.pressed {
                        if !scrubbing && abs(self.mouse-x - press-x) > 4px {
                            scrubbing = true;
                            Controls.set-value(hold-index, 1);
                        }
                        if scrubbing {
                            Controls.set-value(position-index, clamp(self.mouse-x / self.width, 0, 1));
                        }
                    }
                }
            }
        }
        // Time, BPM and tempo, key.
        HorizontalLayout {
            height: 44px;
            spacing: 10px;
            Readout {
                label: "REMAIN";
                value: info.loaded ? "-" + info.remaining : "-00:00.0";
                value-color: info.end-flash-time ? Theme.danger : Theme.text;
                size: wide ? 28px : 22px;
                horizontal-stretch: 1;
            }
            Readout {
                label: "TEMPO " + info.range;
                value: info.loaded ? info.rate : "0.0%";
                size: wide ? 18px : 15px;
                align: right;
            }
            Readout {
                label: "KEY";
                value: info.loaded ? info.key : "-";
                detail: info.key-shift;
                size: wide ? 22px : 18px;
                align: right;
            }
            Readout {
                label: "BPM";
                value: info.loaded ? info.bpm : "-";
                size: wide ? 28px : 22px;
                align: right;
                min-width: wide ? 90px : 70px;
            }
        }
        // The buttons: beat jumps, MASTER TEMPO (key lock), SYNC, MASTER,
        // QUANTIZE and SLIP.
        HorizontalLayout {
            height: 34px;
            spacing: 4px;
            ControlButton { group: group; key: "beatjump_backward"; text: "◀ " + jump-label; momentary: true; tint: tint; font-size: 12px; horizontal-stretch: 1; }
            ControlButton { group: group; key: "beatjump_forward"; text: jump-label + " ▶"; momentary: true; tint: tint; font-size: 12px; horizontal-stretch: 1; }
            ControlButton { group: group; key: "keylock"; text: wide ? "MASTER TEMPO" : "M.TEMPO"; outline-when-lit: true; tint: Theme.danger; font-size: 11px; horizontal-stretch: 2; }
            ControlButton { group: group; key: "sync_enabled"; text: "SYNC"; outline-when-lit: true; tint: tint; font-size: 11px; horizontal-stretch: 1; }
            ControlButton { group: group; key: "sync_leader"; text: "MASTER"; fill-when-lit: true; tint: Theme.cue; font-size: 11px; horizontal-stretch: 1; }
            ControlButton { group: group; key: "quantize"; text: "Q"; outline-when-lit: true; tint: tint; font-size: 11px; horizontal-stretch: 0; min-width: 30px; }
            if wide: ControlButton { group: group; key: "slip_enabled"; text: "SLIP"; outline-when-lit: true; tint: tint; font-size: 11px; horizontal-stretch: 1; }
        }
        // The stems: tap one to mute it.
        HorizontalLayout {
            height: 24px;
            spacing: 4px;
            if info.stem-names.length == 0: Text {
                text: info.loaded ? (info.stem-status != "" ? info.stem-status : "Stems are being made") : "";
                color: Theme.text-dim;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
            for name[i] in info.stem-names: StemChip {
                name: name;
                tint: i < info.stem-colors.length ? info.stem-colors[i] : tint;
                group: "[Channel" + (deck + 1) + "_Stem" + (i + 1) + "]";
            }
            if looping: Rectangle {
                width: 70px;
                border-radius: 4px;
                background: Theme.cue.with-alpha(0.25);
                border-width: 1px;
                border-color: Theme.cue;
                Text { text: "LOOP " + info.loop-size; color: Theme.text; font-size: 11px; font-weight: 700; }
            }
        }
    }

    if TrackDrag.active || drop.has-drag: Rectangle {
        border-width: drop.has-drag ? 3px : 2px;
        border-color: drop.has-drag ? tint : tint.transparentize(0.55);
        background: drop.has-drag ? tint.transparentize(0.9) : transparent;
    }
}

// The small mark at the left of each large waveform: the deck's number in
// its colour, lit while it plays, with its remaining time and BPM.
export component WaveTag inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    property <bool> playing: Controls.value(Controls.resolve(group, "play"), Controls.tick) > 0;
    property <bool> leader: Controls.value(Controls.resolve(group, "sync_leader"), Controls.tick) > 0;
    width: row.preferred-width + 12px;
    height: 26px;
    border-radius: 5px;
    background: Theme.s-000000a0;
    row := HorizontalLayout {
        padding-left: 3px;
        padding-right: 9px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 8px;
        Rectangle {
            width: 20px;
            border-radius: 3px;
            background: playing ? tint : transparent;
            border-width: 1px;
            border-color: tint;
            Text { text: deck + 1; color: playing ? #000000 : tint; font-size: 13px; font-weight: 800; }
        }
        if info.loaded: Text { text: "-" + info.remaining-seconds; color: info.end-flash-time ? Theme.danger : Theme.text; font-family: "Inter Tabular"; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        if info.loaded: Text { text: info.bpm; color: Theme.text-dim; font-family: "Inter Tabular"; font-size: 12px; vertical-alignment: center; }
        if leader: Text { text: "MASTER"; color: Theme.cue; font-size: 10px; font-weight: 800; vertical-alignment: center; }
    }
}
